# Public canonical URL. Phones need HTTPS to load candidate portraits.
SITE_URL=https://ourvote.mstep.dev
# For local development: run Postgres, then db:migrate. Optional for a read-only preview.
DATABASE_URL=postgres://ourvote:change-me@localhost:5432/ourvote
# Leave disabled until an account/plan/key is ready. Never prefix this key NEXT_PUBLIC_.
WEBACTIVITY_API_KEY=
LIVE_ACTIVITIES_ENABLED=false
# Website reads saved results every minute; changed phone results every five minutes.
# Source polling: every six hours before election night, then Toronto 60s / Richmond Hill 120s.
PUSH_INTERVAL_SECONDS=300
# Docker Compose only. Use a unique password (URL-safe characters).
POSTGRES_PASSWORD=change-me
# Private /test controls for real phone delivery. Independent of LIVE_ACTIVITIES_ENABLED.
TEST_MODE_ENABLED=false
# At least 32 characters. bun run test:setup generates one in ignored .env.local.
TEST_ACCESS_TOKEN=
